@page "/"
@inject TrackerStore Store
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Pokédex tracker</PageTitle>
@if (!Store.Ready)
{
    <main class="loading-state"><h1>Loading your trackers</h1><p>@(startupError ?? "Your progress stays on this device until you sync a folder.")</p>
        @if (startupError is not null) { <button onclick="location.reload()">Reload</button> }
    </main>
}
else
{
    <div class="app-shell @(sidebarCollapsed ? "sidebar-collapsed" : "") @(info is not null ? "sources-open" : "")" @onkeydown="ShellKey">
        <aside class="sidebar" aria-label="Tracker navigation">
            <button class="sidebar-toggle" aria-label="@(sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" title="@(sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")" aria-expanded='@(sidebarCollapsed ? "false" : "true")' aria-controls="tracker-navigation" @onclick="ToggleSidebar">
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 4h16v16H4zM9 4v16" /><path d="@(sidebarCollapsed ? "m12 9 3 3-3 3" : "m16 9-3 3 3 3")" /></svg><span hidden="@sidebarCollapsed">Trackers</span>
            </button>
            <div id="tracker-navigation" class="tracker-navigation" hidden="@sidebarCollapsed">
                <button class="primary create-tracker" @onclick="NewTracker" disabled="@(Store.Busy || Store.EditingBlocked)">+ Create tracker</button>
                <nav class="tracker-list" aria-label="Select tracker">
                    @foreach (var tracker in Store.VisibleTrackers)
                    {
                        var total = Store.Catalog.Dexes.SingleOrDefault(d => d.Id == tracker.State.DexId)?.Entries.Count ?? 0;
                        <button class="tracker-item @(selectedId == tracker.State.Id ? "selected" : "")" aria-current="@(selectedId == tracker.State.Id ? "true" : null)" @onclick="() => Select(tracker.State.Id)"><strong>@tracker.State.Name</strong><span>@GameName(tracker.State.GameId) · @DexName(tracker.State.DexId)</span><span class="tracker-count">@Store.CheckedCount(tracker) / @total @(tracker.Pending ? "· pending" : "")</span></button>
                    }
                </nav>
                @if (!Store.VisibleTrackers.Any()) { <p class="muted menu-empty">No trackers yet.</p> }
            </div>
            <button class="settings-button" aria-label="Settings" title="Settings" @onclick='async () => await Store.ShowDialogAsync("settings-dialog")'><svg viewBox="-1.5 -.5 24 24" width="24" height="24" aria-hidden="true"><path d="m9 3-.6 2.2-2 1.2L4.2 6 2.7 8.6l1.6 1.6v2.4l-1.6 1.6L4.2 17l2.2-.4 2 1.2L9 20h3l.6-2.2 2-1.2 2.2.4 1.5-2.8-1.6-1.6v-2.4l1.6-1.6L16.8 6l-2.2.4-2-1.2L12 3z" /><circle cx="10.5" cy="11.5" r="3" /></svg><span hidden="@sidebarCollapsed">Settings</span></button>
        </aside>
        <div class="workspace">
        <main class="main-content" id="main-content" tabindex="-1">
            @if (Store.Error is not null)
            {
                <div class="notice error" role="alert"><span>@Store.Error</span><button aria-label="Dismiss error" @onclick="Store.DismissError">×</button></div>
            }
            @if (Store.CatalogNotice is not null) { <div class="notice">@Store.CatalogNotice</div> }
            @foreach (var conflict in Store.Conflicts)
            {
                <section class="conflict-panel" role="alert">
                    <h2>Resolve @ConflictName(conflict)</h2><p>@conflict.Reason</p>
                    <p class="muted">Your choice replaces this tracker's acknowledged folder versions. Other trackers are unaffected.</p>
                    @if (Store.Trackers.FirstOrDefault(t => t.State.Id == conflict.TrackerId) is { } local)
                    {
                        <button @onclick="() => Store.ResolveAsync(conflict.TrackerId, null, true)" disabled="@(Store.Busy || Store.EditingBlocked)">@(local.Deleted ? "Delete folder tracker" : "Keep this device's version")</button>
                        <small>Edited @local.State.LastEditedUtc.ToLocalTime().ToString("g")</small>
                    }
                    @foreach (var file in conflict.Candidates)
                    {
                        var candidate = Store.ReadCandidate(conflict, file);
                        <div class="conflict-version">
                            @if (candidate is not null)
                            {
                                <button @onclick="() => Store.ResolveAsync(conflict.TrackerId, file.FileName, false)" disabled="@(Store.Busy || Store.EditingBlocked)">Use folder version: @candidate.Name</button>
                                <small>Edited @candidate.LastEditedUtc.ToLocalTime().ToString("g") · @candidate.Checked.Count checked</small>
                            }
                            else { <p>Unreadable or unsupported version, preserved in the folder. Update the app if this file uses a newer catalog.</p> }
                            @if (!file.IntegrityValid) { <strong class="warning-text">Filename hash or identity mismatch</strong> }
                            <code>@file.FileName</code>
                        </div>
                    }
                    @if (conflict.Candidates.Count == 0)
                    { <button class="danger" @onclick="() => Store.ResolveAsync(conflict.TrackerId, null, false)" disabled="@(Store.Busy || Store.EditingBlocked)">Accept folder deletion</button> }
                </section>
            }
            @if (Selected is { } active && Store.Catalog.Dexes.SingleOrDefault(d => d.Id == active.State.DexId) is { } dex)
            {
                int caught = Store.CheckedCount(active);
                <section class="tracker-heading">
                    <div class="tracker-identity"><h1>@active.State.Name</h1><p class="eyebrow">@GameName(active.State.GameId) · @dex.Name Pokédex</p></div>
                    <details class="tracker-actions"><summary>Tracker actions</summary><div><button @onclick='() => OpenAction("rename")'>Rename</button><button @onclick="Duplicate">Duplicate</button><button @onclick='() => OpenAction("reset")'>Reset checks</button><button class="danger" @onclick='() => OpenAction("delete")'>Delete tracker</button></div></details>
                </section>
                <div class="progress-summary"><strong>@caught <span>/ @dex.Entries.Count checked</span></strong><span>@((100.0 * caught / dex.Entries.Count).ToString("0.0"))%</span></div>
                <progress class="completion" value="@caught" max="@dex.Entries.Count" aria-label="Tracker completion"></progress>
                @if (caught == dex.Entries.Count) { <p class="completion-message" role="status">✓ Collection complete. Every Pokémon is checked.</p> }
                <div class="segmented-filter tracker-view" role="group" aria-label="Tracker view">
                    <button class="@(!sourceView ? "active" : "")" aria-pressed='@(!sourceView ? "true" : "false")' @onclick="() => sourceView = false">Checklist</button>
                    <button class="@(sourceView ? "active" : "")" aria-pressed='@(sourceView ? "true" : "false")' @onclick="() => sourceView = true">Sources</button>
                </div>
                @if (sourceView)
                {
                    <SourceLocations @key="active.State.Id" Tracker="active" OnShowInfo="ShowInfo" />
                }
                else
                {
                <div class="tracker-toolbar">
                    <label class="search-label"><span>Search Pokémon</span><input type="search" placeholder="Name, form, or National number" aria-label="Search Pokémon" @bind="search" @bind:event="oninput" /></label>
                    <div class="filter-control"><span>Show</span><div class="segmented-filter" role="group" aria-label="Pokémon completion filter">
                        <button class="@(filter == "all" ? "active" : "")" aria-pressed='@(filter == "all" ? "true" : "false")' @onclick='() => filter = "all"'>All</button>
                        <button class="@(filter == "checked" ? "active" : "")" aria-pressed='@(filter == "checked" ? "true" : "false")' @onclick='() => filter = "checked"'>Checked</button>
                        <button class="@(filter == "unchecked" ? "active" : "")" aria-pressed='@(filter == "unchecked" ? "true" : "false")' @onclick='() => filter = "unchecked"'>Unchecked</button>
                    </div></div>
                    @if (search.Length > 0 || filter != "all")
                    {
                        <div class="results-summary" role="status"><span>@dex.Entries.Count(e => Matches(e, active)) results</span>
                            @if (search.Length > 0) { <button class="text-button" @onclick='() => search = ""'>Clear search</button> }
                            @if (filter != "all") { <button class="text-button" @onclick='() => filter = "all"'>Clear filter</button> }
                        </div>
                    }
                </div>
                @if (!dex.Entries.Any(e => Matches(e, active))) { <p class="notice">No Pokémon match this search and filter.</p> }
                bool extraHeadingShown = false;
                @foreach (var box in Boxes(dex))
                {
                    int visible = box.Entries.Count(e => Matches(e, active));
                    if (visible == 0 && (search.Length > 0 || filter != "all")) { continue; }
                    if (box.Entries.Any(e => e.Extra) && !extraHeadingShown)
                    { <h2 class="extra-heading">Extra forms</h2> extraHeadingShown = true; }
                    <section class="pokemon-box" aria-label="@box.Title">
                        <div class="box-heading"><h2>@box.Title</h2><span>@if (box.Entries.All(e => active.State.Checked.Contains(e.PokemonId))) { <strong>✓ Complete · </strong> }@box.Entries.Count(e => active.State.Checked.Contains(e.PokemonId)) / @box.Entries.Count checked</span></div>
                        <div class="box-grid" style="--columns: @dex.Columns">
                            @foreach (var entry in box.Entries)
                            {
                                var p = Store.Pokemon[entry.PokemonId];
                                bool isChecked = active.State.Checked.Contains(p.Id);
                                <div @key="p.Id" class="pokemon-slot @(isChecked ? "is-checked" : "") @(!Matches(entry, active) ? "filtered-out" : "")">
                                    <label class="pokemon-check" for="check-@p.Id">
                                        <span class="check-target"><input id="check-@p.Id" type="checkbox" checked="@isChecked" @onchange="eventArgs => Store.ToggleAsync(active.State.Id, p.Id, (bool)eventArgs.Value!)" disabled="@(Store.Busy || Store.EditingBlocked)" aria-label="Mark @p.DisplayName" /></span>
                                        <span class="slot-number">@(entry.Extra ? $"#{p.NationalNumber:D4}" : entry.Number?.ToString("D3"))</span>
                                        <img src="sprites/@(p.SpriteId).png" alt="" width="56" height="56" loading="lazy" />
                                        <span class="pokemon-name">@p.Name</span><small class="form-label">@p.Form</small>
                                    </label>
                                    <button class="info-button" aria-label="Sources for @p.DisplayName" aria-controls="sources-panel" aria-expanded='@(info?.Id == p.Id ? "true" : "false")' title="Acquisition sources" @onclick="() => ShowInfo(p)">i</button>
                                </div>
                            }
                            @for (int i = box.Entries.Count; i < dex.Columns * dex.Rows; i++) { <div class="empty-slot" aria-hidden="true"></div> }
                        </div>
                    </section>
                }
                }
            }
            else if (Selected is { } unsupported)
            {
                <section class="welcome"><h1>@unsupported.State.Name</h1><p>This tracker uses a Pokédex the current catalog does not support. Its data is preserved. Export a backup before making changes.</p><button @onclick='() => OpenAction("rename")'>Rename</button><button class="danger" @onclick='() => OpenAction("delete")'>Delete tracker</button></section>
            }
            else if (selectionNotice is not null)
            {
                <section class="welcome"><h1>Tracker unavailable</h1><p role="status">@selectionNotice</p><p class="muted">Choose another tracker from the sidebar, or open Settings to sync a folder. Importing a backup creates independent trackers with their own URLs.</p><button @onclick='async () => await Store.ShowDialogAsync("settings-dialog")'>Open Settings</button></section>
            }
            else
            {
                <section class="welcome"><p class="eyebrow">Switch games and beyond</p><h1>A checklist for every collection</h1><p>Create a tracker for your next playthrough or living dex. Each tracker keeps its own progress, arranged in the same 30-slot boxes as your game.</p><button class="primary" @onclick="NewTracker">Create your first tracker</button>
                    <div class="supported-games">@foreach (var group in Store.Catalog.Games.Select(g => g.Group).Distinct()) { <span>@group</span> }</div>
                    <p class="muted">No account required. Progress is saved in this browser. Export a backup or connect your own folder to move it between devices.</p>
                </section>
            }
            <footer>Unofficial fan project. Pokémon belongs to Nintendo, Game Freak, and Creatures. <a href="https://pokeapi.co/" target="_blank" rel="noopener noreferrer">PokéAPI</a> catalog and sprites · <a href="https://www.serebii.net/" target="_blank" rel="noopener noreferrer">Serebii</a> acquisition sources.</footer>
        </main>
    </div>

        @if (info is { } species)
        {
        <aside id="sources-panel" class="sources-panel" aria-labelledby="info-title">
            <div class="sources-panel-heading"><h2 tabindex="-1" @ref="sourceHeading">Sources</h2><button aria-label="Close sources" title="Close sources" @onclick="CloseInfo">×</button></div>
            <div class="info-heading"><img src="sprites/@(species.SpriteId).png" alt="" width="80" height="80" /><div><p class="eyebrow">National #@species.NationalNumber.ToString("D4")</p><h2 id="info-title">@species.DisplayName</h2></div></div>
            @foreach (var game in SourceGames(species))
            {
                var source = species.SourceFor(game.Id, Store.Dex(Selected!))!;
                <section class="acquisition"><h3>@game.Name</h3>@if (source.Areas.Count > 0) { <p>@string.Join(", ", source.Areas)</p> }<p class="muted">@source.Method</p><a href="@source.Url" target="_blank" rel="noopener noreferrer">Details on Serebii ↗</a></section>
            }
            @if (!SourceGames(species).Any()) { <p>No route record is available for this selection.</p><a href="@($"https://www.serebii.net/pokedex-sv/{species.Id}/")" target="_blank" rel="noopener noreferrer">Details on Serebii</a> }
            @foreach (var game in SourceGames(species).DistinctBy(g => g.Group))
            {
                <EvolutionFamily Catalog="Store.Catalog" Pokemon="Store.Pokemon" PokemonId="@species.Id" GameId="@game.Id" GameName="@game.Group" />
            }
        </aside>
        }
    </div>

    <dialog id="settings-dialog" aria-labelledby="settings-title">
        <div class="settings-heading"><h2 id="settings-title">Settings</h2><button aria-label="Close settings" @onclick='async () => await Store.CloseDialogAsync("settings-dialog")'>×</button></div>
        <label class="theme-control">Theme
            <select aria-label="Theme" value="@Store.Theme" @onchange="ChangeTheme">@foreach (var theme in AppearanceThemes.All) { <option value="@theme.Id">@theme.Name</option> }</select>
        </label>
        @if (AppearanceThemes.Find(Store.Theme).Accents is { Count: > 1 } accents)
        {
            <label class="theme-control">Accent color
                <select aria-label="Accent color" value="@Store.Accent" @onchange="ChangeAccent">@foreach (var accent in accents) { <option value="@accent.Id">@accent.Name</option> }</select>
            </label>
        }
        else if (AppearanceThemes.Find(Store.Theme).AccentDescription is { } accentDescription)
        {
            <p class="muted">@accentDescription</p>
        }
        <label class="theme-control">Appearance
            <select aria-label="Color scheme" value="@Store.ColorScheme" @onchange="ChangeColorScheme"><option value="system">Auto (system)</option><option value="light">Light</option><option value="dark">Dark</option></select>
        </label>
        @if (Store.Error is not null)
        { <div class="notice error" role="alert"><span>@Store.Error</span><button aria-label="Dismiss settings error" @onclick="Store.DismissError">×</button></div> }
        <section class="storage-panel"><h2>Storage status</h2><p>Your checklist is saved in this browser on this device.</p><p class="save-status" role="status">@Store.Status</p><p class="muted">@(Selected?.Pending == true ? "Folder changes pending" : "Folder version saved")</p>
            @if (Selected is { } storedTracker)
            { <p class="muted">Last edited @storedTracker.State.LastEditedUtc.ToLocalTime().ToString("g")</p>
                @if (storedTracker.LastSyncedUtc is { } synced) { <p class="muted">Last synchronized @synced.ToLocalTime().ToString("g")</p> }
            }
        </section>
        <section class="sync-panel" aria-labelledby="sync-title">
            <h2 id="sync-title">Folder sync</h2>
            @if (!Store.Capabilities.Folder)
            {
                <p>Folder sync requires folder access and Web Locks in a secure connection. You can track locally and import or export backups.</p>
                <p class="muted">Brave may disable this API. Cloud sync is planned for a later release.</p>
            }
            else
            {
                <p>@(Store.FolderName is null ? "Select a folder managed by Syncthing or your preferred sync tool." : $"Connected to {Store.FolderName}")</p>
                <div class="button-row">
                    <button @onclick="Store.ChooseFolderAsync" disabled="@(Store.Busy || Store.EditingBlocked)">Choose folder</button>
                    @if (Store.FolderName is null) { <button @onclick="Store.ReconnectAsync" disabled="@(Store.Busy || Store.EditingBlocked)">Reconnect</button> }
                    else { <button class="primary" @onclick="Store.SyncAsync" disabled="@(Store.Busy || Store.EditingBlocked)">@(Store.Busy ? "Syncing…" : "Sync now")</button> }
                </div>
                @if (Store.FolderName is not null) { <button class="text-button" @onclick="Store.DisconnectAsync" disabled="@(Store.Busy || Store.EditingBlocked)">Disconnect folder</button> }
            }
            <p class="save-status" role="status">@Store.Status</p>
            <p class="muted">A folder save does not confirm arrival on another device.</p>
        </section>
        <section class="backup-panel">
            <h2>Backups</h2>
            <div class="button-row"><button @onclick="Store.ExportAsync">Export all</button><label class="file-button">Import<InputFile OnChange="ImportBackup" accept="application/json,.json" /></label></div>
            <p class="muted">Import creates independent copies.</p>
            <button class="text-button" @onclick="Store.RequestPersistentStorageAsync">Request persistent storage</button>
        </section>

        @if (Store.Conflicts.Count > 0)
        {
            <div class="notice"><p>@Store.Conflicts.Count tracker conflict(s) need your choice.</p><button @onclick='async () => await Store.CloseDialogAsync("settings-dialog")'>Review conflicts</button></div>
        }
        <div class="dialog-actions"><button class="primary" @onclick='async () => await Store.CloseDialogAsync("settings-dialog")'>Done</button></div>
    </dialog>
    <dialog id="create-dialog" aria-labelledby="create-title"><form @onsubmit="Create" @onsubmit:preventDefault>
        <h2 id="create-title">New tracker</h2><label>Name<input required maxlength="120" @bind="newName" placeholder="My living dex" /></label>
        @if (Store.Error is not null) { <p class="notice error" role="alert">@Store.Error</p> }
        <label>Game<select aria-label="Game" value="@newGame" @onchange="ChooseGame">@foreach (var group in Store.Catalog.Games.GroupBy(g => g.Group)) { <optgroup label="@group.Key">@foreach (var game in group) { <option value="@game.Id">@game.Name</option> }</optgroup> }</select></label>
        <label>Pokédex<select aria-label="Pokédex" @bind="newDex">@foreach (var d in AvailableDexes) { <option value="@d.Id">@d.Name (@d.Entries.Count entries)</option> }</select></label>
        <p class="muted">Checks belong to this tracker. You can create more trackers for the same Pokédex.</p>
        <div class="dialog-actions"><button type="button" @onclick='async () => await Store.CloseDialogAsync("create-dialog")'>Cancel</button><button class="primary" type="submit" disabled="@(Store.Busy || Store.EditingBlocked)">Create tracker</button></div>
    </form></dialog>
    <dialog id="action-dialog" aria-labelledby="action-title"><form @onsubmit="PerformAction" @onsubmit:preventDefault>
        <h2 id="action-title">@ActionTitle</h2>
        @if (Store.Error is not null) { <p class="notice error" role="alert">@Store.Error</p> }
        @if (action == "rename") { <label>Name<input required maxlength="120" @bind="renameName" /></label> }
        else { <p><strong>@Selected?.State.Name</strong></p><p>@(action == "reset" ? "Clear every check in this tracker?" : "Delete this tracker and its checklist? This will also be applied to your folder when you synchronize.")</p><p class="muted">This action cannot be undone. You can export a backup first.</p> }
        <div class="dialog-actions"><button type="button" @onclick='async () => await Store.CloseDialogAsync("action-dialog")'>Cancel</button><button type="submit" class="@(action == "rename" ? "primary" : "danger")" disabled="@(Store.Busy || Store.EditingBlocked)">@ActionTitle</button></div>
    </form></dialog>

}

@code {
    private bool sidebarCollapsed;
    private bool sourceView;
    private IJSObjectReference? ui;
    private ElementReference sourceHeading;
    private bool focusSourceHeading;
    private async Task ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
        await ui!.InvokeVoidAsync("saveSidebarCollapsed", sidebarCollapsed);
    }
    private async Task ShellKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && info is not null) await CloseInfo();
    }
    private async Task CloseInfo()
    {
        info = null;
        await ui!.InvokeVoidAsync("restoreSourceFocus");
    }
    private Guid? selectedId;
    private Guid? lastOpenedId;
    private string? selectionNotice;
    [SupplyParameterFromQuery(Name = "tracker")] public string? TrackerId { get; set; }
    private string search = "", filter = "all", newName = "", newGame = "scarlet", newDex = "paldea", action = "", renameName = "";
    private string? startupError;
    private PokemonVariant? info;
    private LocalTracker? Selected => Store.VisibleTrackers.FirstOrDefault(t => t.State.Id == selectedId);
    private IEnumerable<DexDefinition> AvailableDexes => Store.Catalog.Dexes.Where(d => d.Group == Store.Catalog.Games.Single(g => g.Id == newGame).Group);
    private string ActionTitle => action switch { "rename" => "Rename tracker", "reset" => "Reset checks", _ => "Delete tracker" };
    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnChanged;
        try
        {
            ui = await JS.InvokeAsync<IJSObjectReference>("import", "./layout.js");
            sidebarCollapsed = await ui.InvokeAsync<bool>("getSidebarCollapsed");
            await Store.InitializeAsync();
            string? saved = await ui.InvokeAsync<string?>("getLastTracker");
            lastOpenedId = Guid.TryParse(saved, out var id) ? id : null;
        }
        catch (Exception ex) { startupError = "Could not open local progress or the catalog. Existing data has not been replaced. " + ex.Message; }
    }
    private void OnChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Store.Ready && Selected is null)
            {
                if (selectedId is not null)
                    await SelectTracker(Store.VisibleTrackers.FirstOrDefault()?.State.Id, replace: true);
                else await RestoreSelection();
            }
            StateHasChanged();
        });
    }
    protected override Task OnParametersSetAsync() => Store.Ready ? RestoreSelection() : Task.CompletedTask;
    private async Task RestoreSelection()
    {
        Guid? target;
        selectionNotice = null;
        if (TrackerId is not null)
        {
            if (!Guid.TryParse(TrackerId, out var requested))
            {
                target = null;
                selectionNotice = "This URL contains an invalid tracker ID.";
            }
            else if (Store.VisibleTrackers.Any(t => t.State.Id == requested)) target = requested;
            else
            {
                target = null;
                selectionNotice = "This tracker is not available on this device. Sync the folder containing it to open this link.";
            }
        }
        else target = Store.VisibleTrackers.Any(t => t.State.Id == lastOpenedId)
            ? lastOpenedId : Store.VisibleTrackers.FirstOrDefault()?.State.Id;
        if (selectedId != target) { info = null; search = ""; filter = "all"; }
        selectedId = target;
        if (target is not null || TrackerId is null)
        {
            lastOpenedId = target;
            await ui!.InvokeVoidAsync("saveLastTracker", target?.ToString("N"));
        }
        if (TrackerId is null && target is not null)
            Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tracker", target.Value.ToString("N")), replace: true);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Store.Ready) await Store.ApplyAppearanceAsync(Selected?.State.GameId);
        if (focusSourceHeading && info is not null) { focusSourceHeading = false; await sourceHeading.FocusAsync(preventScroll: true); }
    }
    private Task Select(Guid id) => SelectTracker(id);
    private async Task SelectTracker(Guid? id, bool replace = false)
    {
        info = null; selectedId = id; lastOpenedId = id; selectionNotice = null; search = ""; filter = "all";
        await ui!.InvokeVoidAsync("saveLastTracker", id?.ToString("N"));
        Navigation.NavigateTo(Navigation.GetUriWithQueryParameter("tracker", id?.ToString("N")), replace: replace);
    }
    private string GameName(string id) => Store.Catalog.Games.SingleOrDefault(g => g.Id == id)?.Name ?? id;
    private string DexName(string id) => Store.Catalog.Dexes.SingleOrDefault(d => d.Id == id)?.Name ?? id;
    private string ConflictName(TrackerConflict conflict) => Store.Trackers.FirstOrDefault(t => t.State.Id == conflict.TrackerId)?.State.Name ?? "folder tracker";
    private bool Matches(DexEntry entry, LocalTracker tracker)
    {
        var p = Store.Pokemon[entry.PokemonId]; bool check = tracker.State.Checked.Contains(p.Id);
        return (filter == "all" || filter == "checked" && check || filter == "unchecked" && !check) &&
            (search.Length == 0 || p.DisplayName.Contains(search.Trim(), StringComparison.OrdinalIgnoreCase) || p.NationalNumber.ToString().Equals(search.Trim().TrimStart('#', '0'), StringComparison.Ordinal));
    }
    private IEnumerable<(string Title, List<DexEntry> Entries)> Boxes(DexDefinition dex)
    {
        int size = dex.Columns * dex.Rows, position = 1;
        foreach (var entries in dex.Entries.Where(e => !e.Extra).Chunk(size))
        {
            yield return ($"{position:D3}-{position + entries.Length - 1:D3}", entries.ToList());
            position += entries.Length;
        }
        int extra = 1;
        foreach (var entries in dex.Entries.Where(e => e.Extra).Chunk(size)) yield return ($"Extra forms · Box {extra++:D2}", entries.ToList());
    }
    private async Task NewTracker() { newName = ""; await Store.ShowDialogAsync("create-dialog"); }
    private void ChooseGame(ChangeEventArgs args) { newGame = args.Value!.ToString()!; newDex = AvailableDexes.First().Id; }
    private async Task Create()
    {
        await Store.CreateAsync(newName, newGame, newDex);
        if (Store.Error is null) { await Select(Store.VisibleTrackers.Last().State.Id); await Store.CloseDialogAsync("create-dialog"); }
    }
    private async Task OpenAction(string value) { action = value; renameName = Selected?.State.Name ?? ""; await Store.ShowDialogAsync("action-dialog"); }
    private async Task PerformAction()
    {
        if (Selected is not { } active) return;
        if (action == "rename") await Store.RenameAsync(active.State.Id, renameName);
        else if (action == "reset") await Store.ResetAsync(active.State.Id);
        else await Store.DeleteAsync(active.State.Id);
        if (Store.Error is null) await Store.CloseDialogAsync("action-dialog");
    }
    private async Task Duplicate() { if (Selected is { } active) { await Store.DuplicateAsync(active.State.Id); if (Store.Error is null) await Select(Store.VisibleTrackers.Last().State.Id); } }
    private async Task ShowInfo(PokemonVariant species)
    {
        await ui!.InvokeVoidAsync("rememberSourceOpener");
        focusSourceHeading = info is null;
        info = species;
    }
    private IEnumerable<GameDefinition> SourceGames(PokemonVariant species) => Store.Catalog.Games.Where(g => Selected is not null && species.SourceFor(g.Id, Store.Dex(Selected)) is not null &&
        (Selected?.State.GameId == "home" || g.Group == Store.Catalog.Games.SingleOrDefault(game => game.Id == Selected?.State.GameId)?.Group));
    private Task ChangeAccent(ChangeEventArgs args) => Store.SetAccentAsync(args.Value!.ToString()!);
    private Task ChangeTheme(ChangeEventArgs args) => Store.SetThemeAsync(args.Value!.ToString()!);
    private Task ChangeColorScheme(ChangeEventArgs args) => Store.SetColorSchemeAsync(args.Value!.ToString()!);
    private async Task ImportBackup(InputFileChangeEventArgs args)
    {
        try { using var reader = new StreamReader(args.File.OpenReadStream(10 * 1024 * 1024)); await Store.ImportAsync(await reader.ReadToEndAsync()); }
        catch (Exception ex) { Store.ReportError("Could not import backup: " + ex.Message); }
    }
    public async ValueTask DisposeAsync()
    {
        Store.Changed -= OnChanged;
        if (ui is not null) await ui.DisposeAsync();
    }
}
